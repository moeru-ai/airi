{
  "name": "@proj-airi/debug-server",
  "type": "module",
  "private": true,
  "description": "Local OTLP persistence and query service for AIRI development.",
  "exports": {
    ".": "./src/runtime.ts",
    "./config": "./src/config.ts"
  },
  "scripts": {
    "dev": "tsx watch ./src/bin.ts",
    "start": "tsx ./src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@buf/googleapis_googleapis.bufbuild_es": "catalog:",
    "@buf/opentelemetry_opentelemetry.bufbuild_es": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@duckdb/node-api": "catalog:",
    "@duckdbfan/drizzle-duckdb": "catalog:",
    "@guiiai/logg": "catalog:",
    "@hono/node-server": "catalog:",
    "@proj-airi/stage-shared": "workspace:^",
    "async-mutex": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-logs-otlp-proto": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:vitest"
  }
}
