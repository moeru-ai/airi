+  role: v.picklist(['user', 'system', 'developer', 'assistant']),
+  content: v.union([v.string(), v.array(v.union([inputPart, outputPart]))]),
+  phase: v.optional(v.nullable(base.vAssistantMessageItemParam.entries.phase.wrapped)),
+})
+
