@@ -1040,0 +1041,34 @@ function usageFromJson(obj) {
+/** Keeps tool-result images as native content blocks and rejects unsupported inputs. */
+function toolResultContent(content) {
+  if (typeof content === 'string') return content;
+  if (!Array.isArray(content) || content.length === 0) {
+    throw new Error('Invalid tool result: content must be text or a nonempty content array.');
+  }
+  return content.map((part) => {
+    if (part?.type === 'text' && typeof part.text === 'string') {
+      return { type: 'text', text: part.text };
+    }
+    if (part?.type !== 'image_url' || typeof part.image_url?.url !== 'string') {
+      throw new Error('Invalid tool result: unsupported content part.');
+    }
+    const match = /^data:(image\/(?:png|jpeg|webp));base64,([A-Za-z0-9+/]+={0,2})$/.exec(part.image_url.url);
+    if (!match) throw new Error('Invalid tool result: expected an inline PNG, JPEG, or WebP image.');
+    const [, mediaType, data] = match;
+    const maxBytes = 8 * 1024 * 1024;
+    if (data.length > 4 * Math.ceil(maxBytes / 3)) {
+      throw new Error('Invalid tool result: image exceeds 8 MiB.');
+    }
+    const bytes = Buffer.from(data, 'base64');
+    if (bytes.length === 0 || bytes.length > maxBytes || bytes.toString('base64') !== data) {
+      throw new Error('Invalid tool result: invalid or oversized image data.');
+    }
+    const png = bytes.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]));
+    const jpeg = bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255;
+    const webp = bytes.toString('ascii', 0, 4) === 'RIFF' && bytes.toString('ascii', 8, 12) === 'WEBP';
+    if (!((mediaType === 'image/png' && png) || (mediaType === 'image/jpeg' && jpeg) || (mediaType === 'image/webp' && webp))) {
+      throw new Error('Invalid tool result: image MIME type does not match its signature.');
+    }
+    return { type: 'image', source: { type: 'base64', media_type: mediaType, data } };
+  });
+}
