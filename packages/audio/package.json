{
  "name": "@proj-airi/audio",
  "type": "module",
  "private": true,
  "description": "Audio processing utilities for Project AIRI",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moeru-ai/airi.git",
    "directory": "packages/audio"
  },
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "default": "./dist/browser/index.mjs"
    },
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.mts",
      "default": "./dist/encoding/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "pnpm run build",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "catalog:",
    "@moeru/std": "catalog:",
    "@proj-airi/pipelines-audio": "workspace:*",
    "mediabunny": "catalog:",
    "nanoid": "catalog:"
  },
  "devDependencies": {
    "@types/audioworklet": "catalog:",
    "vue": "catalog:"
  }
}
