# Endpoints and keys only. The matrix, the model names, and the voices are in
# eval/tasks/read-aloud/config.ts, and the rewrite model is in eval/test-objects/llm/vieval.config.ts.

# The listener writes down what it heard as LaTeX. Any OpenAI-compatible endpoint works.
LISTENER_BASE_URL='https://api.openai.com/v1/'
LISTENER_API_KEY=''

# CLIProxyAPI as provider
# LISTENER_BASE_URL='http://localhost:8317/v1'
# LISTENER_API_KEY='local-key'

# The rewrite model of the `llm` test object.
REWRITE_BASE_URL='https://api.openai.com/v1/'
REWRITE_API_KEY=''

# CLIProxyAPI as provider
# REWRITE_BASE_URL='http://localhost:8317/v1'
# REWRITE_API_KEY='local-key'

# Speech recognition, needed when the `tts` axis has a provider.
# A whisper.cpp server started with `--inference-path /v1/audio/transcriptions` also works.
ASR_BASE_URL='https://api.openai.com/v1/'
ASR_API_KEY=''

# Gemini as an ASR model of the `asr` axis. It uses the Gemini `generateContent` API, not an OpenAI-compatible endpoint.
# Set the API root: Google itself, or a proxy route that forwards the Gemini API.
ASR_GEMINI_BASE_URL='https://generativelanguage.googleapis.com/v1beta/'
ASR_GEMINI_API_KEY=''

# One pair per TTS provider in the `tts` axis: TTS_<PROVIDER>_BASE_URL and TTS_<PROVIDER>_API_KEY.
TTS_OFFICIAL_BASE_URL='https://api.airi.build/api/v1/'
TTS_OFFICIAL_API_KEY=''

TTS_AZURE_BASE_URL='http://127.0.0.1:5933/v1/'
TTS_AZURE_API_KEY=''

# Optional, for development: case ids and languages to run. Empty runs all 67 cases in all four languages.
EVAL_CASES=''
EVAL_LANGUAGES=''
# Optional: ASR models to run instead of the default `asr` axis, for example `gemini-3.8-flash`.
EVAL_ASR=''
