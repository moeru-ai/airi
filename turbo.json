{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@proj-airi/apple-speech-transcription#build": {
      "outputs": ["native/**/*.node"]
    },
    "@proj-airi/drizzle-migration#build": {
      "cache": false
    },
    "@proj-airi/electron-vueuse#build": {
      "dependsOn": ["@proj-airi/electron-eventa#build"],
      "outputs": ["dist/**"]
    }
  }
}
